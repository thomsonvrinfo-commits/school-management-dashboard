{
  "name": "schoolpulse",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "e2e"],
  "engines": { "node": ">=22.18" },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --no-warnings --test \"packages/*/test/*.test.ts\" \"apps/api/test/*.test.ts\" \"apps/web/test/*.test.ts\"",
    "check:render": "bun apps/web/check/render-check.tsx && bun apps/web/check/admin-render-check.tsx && bun apps/web/check/staff-render-check.tsx && bun apps/web/check/activity-render-check.tsx",
    "e2e": "npm test -w @schoolpulse/e2e",
    "check:imports": "node --no-warnings scripts/check-imports.ts",
    "db:up": "docker compose up -d db",
    "db:migrate": "node --no-warnings packages/db/scripts/migrate.ts",
    "db:seed:dev": "node --no-warnings apps/api/scripts/seed-dev.ts",
    "operator": "node --no-warnings apps/api/scripts/operator.ts",
    "dev:api": "npm run dev -w @schoolpulse/api",
    "dev:web": "npm run dev -w @schoolpulse/web",
    "build:web": "npm run build -w @schoolpulse/web",
    "serve:web": "npm run serve -w @schoolpulse/web"
  }
}
